#!/usr/bin/env python3
"""Toggle a Wizarch panel on the currently focused monitor."""
import json,subprocess,sys
from pathlib import Path
try:
    section=sys.argv[1]
    if section not in ('launcher','clock','status','notifications','settings','wifi','bluetooth','clipboard','emoji','themes'): raise ValueError('Unknown panel')
    if section in ('clipboard', 'emoji'):
        window=json.loads(subprocess.check_output(['hyprctl','activewindow','-j'],text=True,timeout=3))
        address=window.get('address','')
        if address.startswith('0x'):
            focus_file=Path.home()/'.cache'/'wizarch'/'previous-window'
            focus_file.parent.mkdir(parents=True,exist_ok=True)
            focus_file.write_text(address)
    monitors=json.loads(subprocess.check_output(['hyprctl','monitors','-j'],text=True,timeout=3))
    monitor=next(m['name'] for m in monitors if m['focused'])
    subprocess.run(['qs','ipc','call','--','panel-'+monitor,'togglePanel',section],check=True,timeout=3)
except (OSError,ValueError,IndexError,StopIteration,subprocess.SubprocessError) as error:
    print('Wizarch: '+str(error),file=sys.stderr);sys.exit(1)
