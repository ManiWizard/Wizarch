#!/usr/bin/env python3
"""Toggle a Wizarch panel on the currently focused monitor."""
import json,subprocess,sys
try:
    section=sys.argv[1]
    if section not in ('launcher','clock','status','notifications','themes'): raise ValueError('Unknown panel')
    monitors=json.loads(subprocess.check_output(['hyprctl','monitors','-j'],text=True,timeout=3))
    monitor=next(m['name'] for m in monitors if m['focused'])
    subprocess.run(['qs','ipc','call','--','panel-'+monitor,'togglePanel',section],check=True,timeout=3)
except (OSError,ValueError,IndexError,StopIteration,subprocess.SubprocessError) as error:
    print('Wizarch: '+str(error),file=sys.stderr);sys.exit(1)
