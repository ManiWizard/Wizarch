Window.SetBackgroundTopColor(0.035, 0.045, 0.075);
Window.SetBackgroundBottomColor(0.015, 0.020, 0.040);

logo = Image("logo.png");
sprite = Sprite(logo);
sprite.SetX(Window.GetWidth() / 2 - logo.GetWidth() / 2);
sprite.SetY(Window.GetHeight() / 2 - logo.GetHeight() / 2);
phase = 0;

fun refresh() {
    phase += 0.055;
    sprite.SetOpacity(0.70 + 0.25 * Math.Sin(phase));
}
Plymouth.SetRefreshFunction(refresh);
